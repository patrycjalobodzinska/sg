# Sanity — public (safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=

# Server-only Sanity write token (seed/migration script, draft previews)
SANITY_API_WRITE_TOKEN=

# --- Contact form -----------------------------------------------------------
# Without RESEND_API_KEY the form does NOT silently succeed: it logs the failure
# server-side and shows the visitor the "please email us instead" error state.
RESEND_API_KEY=
# Inbox that receives inquiries (default: contact@sgpapertronics.com)
CONTACT_INBOX=
# Verified sender for the Resend domain
CONTACT_FROM=
# Product documentation sent by the "Request product documentation" intent.
# Normally the PDF is uploaded in Studio (Site settings → Contact → Product
# documentation), which lets the client swap it without a deploy; this is only a
# staging override. With neither set, nothing is auto-sent: the request still
# reaches CONTACT_INBOX and the form promises a reply, never a document.
PRODUCT_DOC_URL=
